# Copy to .env and fill in. .env is git-ignored: never commit it, never paste it anywhere.
# Make random values with: openssl rand -hex 32

# Token signing key (at least 32 characters).
SECRET_KEY=

# Database password. On a laptop that already has a database, keep the password it was created with.
POSTGRES_PASSWORD=

# Password for the starting admin account (required on a server).
ADMIN_PASSWORD=

# Optional starting accounts: set a password to create the account on first start; leave empty to skip.
# More staff later: docker compose exec app python -m app.manage add-staff <username> <role>
BARISTA_PASSWORD=
BOOTH_LEAD_PASSWORD=

# Server only: the address of the live link, e.g. 128-199-1-2.sslip.io or a real domain.
DOMAIN=

# Optional: public address used in guest QR links (the server sets it from DOMAIN).
GUEST_BASE_URL=
